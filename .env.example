# Neon Postgres connection string (get this from your Neon project dashboard)
# Use the "pooled connection" string for the app, and the direct string for migrations if Neon gives you both.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/rheewaz?sslmode=require"

# Long random string used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Bootstrap credentials — only used by scripts/seed.ts to create the first Boss & Admin accounts.
# Change these passwords immediately after first login.
SEED_BOSS_EMAIL="bellowk55@gmail.com"
SEED_BOSS_PASSWORD="changeyourpassword"
SEED_ADMIN_EMAIL="bystus289@gmail.com"
SEED_ADMIN_PASSWORD="changeyourpassword"

# Secret used to authorize the weekly-rollover cron endpoint (Vercel Cron sends this as a header).
CRON_SECRET="replace-with-another-long-random-secret"
